# Copy to .env and adjust. .env is git-ignored; this file is committed.

# Database (local only)
DB_NAME=wordpress
DB_USER=wordpressuser
DB_PASSWORD=wordpresspassword
DB_ROOT_PASSWORD=rootpassword

# Xdebug: off | debug | develop | profile | trace (comma-separate to combine).
# After changing it: docker compose up -d
XDEBUG_MODE=off

# Table prefix: must equal staging's (`make pull-staging` checks and tells you).
DB_TABLE_PREFIX=wp_

# make pull-staging
STAGING_SSH=
STAGING_PATH=/var/www/vhosts/mindzersystems.com/staging.mindzersystems.com
STAGING_URL=https://staging.mindzersystems.com
STAGING_WP=wp
LOCAL_URL=https://localhost
